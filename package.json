{
  "name": "finguard-ai",
  "version": "1.0.0",
  "description": "FinGuard AI — Real-Time Financial Surveillance, Expert System & Hybrid AI Anti-Fraud Platform",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "start": "python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000",
    "test:backend": "cd backend && pytest"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
